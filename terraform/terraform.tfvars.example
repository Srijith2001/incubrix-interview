# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

aws_region  = "ap-south-1"
environment = "dev"
app_name    = "incubrix-backend"
app_port    = 8080
image_tag   = "latest"

# 0.25 vCPU / 0.5 GB is enough for this service; raise for load testing.
cpu    = "256"
memory = "512"

min_instances = 1
max_instances = 3

# Origins the browser UI is served from. Leave unset to keep the binary's
# localhost defaults.
# cors_allowed_origins = "https://ui.example.com"

# GitHub Actions deploy role. Empty (the default) creates no role at all.
# github_repository = "Srijith2001/incubrix-interview"
# create_github_oidc_provider = true   # false if the account already has one

# The CI pipeline owns deploys once it is wired up; leave this true and a
# `docker push` from a laptop deploys too.
# auto_deployments_enabled = true
